API_PORT=8787

# Public URL of frontend for YooKassa return_url
PUBLIC_BASE_URL=http://127.0.0.1:5173
JWT_SECRET=change_me
# Optional extra secret for hashing one-time email verification codes.
# If empty, JWT_SECRET is used.
EMAIL_CODE_HASH_SECRET=

# PostgreSQL
# Example:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mossybloom
DATABASE_URL=
# Verify Postgres TLS certificate (recommended for production)
# Set to false only for temporary local troubleshooting.
PG_SSL_REJECT_UNAUTHORIZED=true

# Bitrix24 incoming webhook base URL:
# Example: https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
BITRIX24_WEBHOOK_URL=

# Telegram bot config
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional bot username without @. If empty, backend will try to detect it via getMe.
TELEGRAM_BOT_USERNAME=
# Optional secret token for Telegram webhook requests (recommended)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to change order statuses via bot buttons
TELEGRAM_ADMIN_IDS=

# YooKassa credentials
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMS provider (sms.ru)
SMSRU_API_ID=

# DaData address suggestions
DADATA_API_KEY=5920638e4176b9e365f0d6d2dd1dc64615fbcafa

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If empty, backend uses: ${PUBLIC_BASE_URL}/api/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=

# OAuth (Yandex)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Optional. If empty, backend uses: ${PUBLIC_BASE_URL}/api/auth/oauth/yandex/callback
YANDEX_REDIRECT_URI=

# Optional admin API protection token for manual order-status updates
ADMIN_API_TOKEN=

# Optional override for Vite dev proxy
VITE_API_BASE_URL=http://127.0.0.1:8787

# CMS provider: strapi (default) or legacy (old localStorage CMS)
VITE_CMS_PROVIDER=strapi
VITE_STRAPI_URL=http://127.0.0.1:1337


# Unisender transactional email
UNISENDER_API_KEY=
UNISENDER_SENDER_EMAIL=
UNISENDER_SENDER_NAME=MossyBloom
# Optional override (default: https://api.unisender.com/ru/api/sendEmail)
UNISENDER_API_URL=
